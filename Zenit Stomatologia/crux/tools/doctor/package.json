{
  "name": "@crux/doctor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "crux-doctor": "./src/cli.ts"
  },
  "scripts": {
    "doctor": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
