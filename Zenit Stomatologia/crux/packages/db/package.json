{
  "name": "@crux/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:diff": "supabase db diff",
    "db:push:staging": "echo 'Manual only: supabase db push --linked' && exit 1",
    "db:types": "mkdir -p src/generated && supabase gen types typescript --local > src/generated/database.ts"
  },
  "dependencies": {
    "@crux/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
