{
  "name": "@crux/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:diff": "supabase db diff",
    "db:push:staging": "echo 'Manual only: supabase db push --linked' && exit 1",
    "db:types": "mkdir -p src/generated && supabase gen types typescript --local > src/generated/database.ts"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
