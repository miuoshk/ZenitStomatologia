{
  "name": "@crux/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./crux-logo": "./src/components/CruxLogo.tsx",
    "./zenit-logo": "./src/components/ZenitLogo.tsx",
    "./num": "./src/components/Num.tsx",
    "./brand/*": "./brand/*",
    "./tokens.css": "./brand/tokens.css",
    "./tokens.extra.css": "./src/tokens.extra.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "brand:sync": "node scripts/brand-sync.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "echo \"test:visual: placeholder (Playwright + Storybook, K08)\"",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "react-hook-form": "7.63.0",
    "recharts": "3.2.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "9.1.10",
    "@storybook/react-vite": "9.1.10",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "storybook": "9.1.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "7.1.9",
    "vitest": "5.1.2"
  }
}
