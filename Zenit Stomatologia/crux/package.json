{
  "name": "crux",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:deps": "depcruise --config packages/config/dependency-cruiser.cjs apps packages",
    "lint:deps:graph": "mkdir -p docs/generated && depcruise --config packages/config/dependency-cruiser.cjs --output-type dot apps packages | dot -T svg > docs/generated/deps.svg",
    "test": "vitest run --passWithNoTests",
    "test:db": "pnpm db:test",
    "test:visual": "echo 'test:visual placeholder (K10/K14)' && exit 0",
    "doctor": "tsx tools/doctor/src/cli.ts",
    "crux-doctor": "tsx tools/doctor/src/cli.ts",
    "gen": "tsx tools/gen/src/cli.ts",
    "e2e": "pnpm --filter @crux/web e2e",
    "format": "prettier --write .",
    "lint:packages": "turbo run lint",
    "db:start": "pnpm --filter @crux/db db:start",
    "db:reset": "pnpm --filter @crux/db db:reset",
    "db:test": "pnpm --filter @crux/db db:test",
    "db:diff": "pnpm --filter @crux/db db:diff",
    "db:types": "pnpm --filter @crux/db db:types",
    "db:generate": "pnpm --filter @crux/db db:generate",
    "db:push:staging": "pnpm --filter @crux/db db:push:staging",
    "seed:demo": "tsx packages/testing/src/seed-demo.ts",
    "analytics:refresh": "tsx packages/modules/analytics/src/refresh/cli.ts",
    "bootstrap:prod": "tsx tools/bootstrap-prod.ts"
  },
  "devDependencies": {
    "@crux/db": "workspace:*",
    "@crux/identity": "workspace:*",
    "@crux/org": "workspace:*",
    "@crux/platform": "workspace:*",
    "@crux/shared": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "@vitest/coverage-v8": "5.1.2",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-boundaries": "7.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "supabase": "3.4.0",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  },
  "type": "module"
}
