# Crux · local / staging env template (K02). Copy to .env — never commit secrets.

# App DB role (transaction pooler). Local pooler: 54329. Hosted Supavisor: 6543.
DATABASE_URL=postgresql://crux_app:crux_app_local_only@127.0.0.1:54329/postgres

# Worker DB role (session / direct). Local DB: 54322. Hosted: 5432.
DATABASE_URL_WORKER=postgresql://crux_worker:crux_worker_local_only@127.0.0.1:54322/postgres

# Supabase Auth (browser) — local API when enabled; production from dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# KMS (filled in K03)
KMS_PROVIDER=
KMS_KEY_ID=
KMS_LOCAL_DEK=
KMS_LOCAL_PEPPER=

# Integrations
FAKE_INTEGRATIONS=1
