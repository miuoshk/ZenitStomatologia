# Crux · local / staging env template (K02). Copy to .env — never commit secrets.

# App DB role. Local: direct 54322 (pooler 54329 needs Supavisor tenant id). Hosted pooler: 6543.
DATABASE_URL=postgresql://crux_app:crux_app_local_only@127.0.0.1:54322/postgres

# Worker DB role (session / direct). Local DB: 54322. Hosted: 5432.
DATABASE_URL_WORKER=postgresql://crux_worker:crux_worker_local_only@127.0.0.1:54322/postgres

# Kopia nocna (pg_dump) — rola crux_backup: tylko odczyt, BYPASSRLS. Lokalnie hasło z seed.sql.
# Hostowane: LOGIN i hasło ustawia operator (docs/ops/kopie-i-odtwarzanie.md). pg_dump ≥ 17.
DATABASE_URL_BACKUP=postgresql://crux_backup:crux_backup_local_only@127.0.0.1:54322/postgres

# Supabase Auth (browser) — local API when enabled; production from dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Admin Auth (invite / e2e seed) — never expose to browser; never log.
SUPABASE_SECRET_KEY=
# Idle lock override for e2e (ms). Default 300000.
# CRUX_IDLE_LOCK_MS=500

# KMS / szyfrowanie lokalne (K03) — NIE produkcja. 32 bajty jako 64 hex.
KMS_PROVIDER=local
KMS_KEY_ID=local-v1
KMS_LOCAL_DEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KMS_LOCAL_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Integrations
FAKE_INTEGRATIONS=1

# Worker (K09)
WORKER_HEALTH_PORT=8081
BACKUP_LOCAL_DIR=./.data/backups
LOG_LEVEL=info

# Obserwowalność (K16, ADR-016) — bez PII; puste = wyłączone (no-op).
# SENTRY_DSN MUSI być projektem w regionie UE (*.ingest.de.sentry.io) z podpisanym DPA.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# OpenTelemetry (tylko kolektor w UE / własny serwer). Puste = wyłączone.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=crux-web

# seed:demo (K12) — ładuje golden dataset (13 mies.) i CZYŚCI bazę (tests.reset_fixtures).
# Zablokowane dla hostów produkcyjnych: domyślnie db.crux.zenitstomatologia.pl oraz
# aws-0-eu-central-1.pooler.supabase.com; dopisz własne (csv) poniżej.
# Dozwolone: localhost / 127.0.0.1 (Supabase local). Zdalny staging: CRUX_SEED_ALLOW_REMOTE=1.
# CRUX_PRODUCTION_DB_HOSTS=db.crux.zenitstomatologia.pl,aws-0-eu-central-1.pooler.supabase.com
# CRUX_SEED_ALLOW_REMOTE=1
