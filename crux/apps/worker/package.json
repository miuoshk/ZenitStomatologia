{
  "name": "@crux/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "pino-pretty": "13.0.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@crux/analytics": "workspace:*",
    "@crux/db": "workspace:*",
    "@crux/integrations": "workspace:*",
    "@crux/platform": "workspace:*",
    "@crux/shared": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/sdk-node": "0.301.2",
    "@sentry/node": "11.18.0",
    "pg-boss": "10.1.5",
    "pino": "9.7.0",
    "zod": "4.6.7"
  }
}
