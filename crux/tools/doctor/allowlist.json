{
  "rules": {
    "code.no-as-unknown": [
      {
        "path": "apps/worker/src/dispatch/outbox.ts",
        "reason": "postgres.js RowList → OutboxRow; brak stabilnego typu RETURNING w drizzle execute"
      },
      {
        "path": "packages/modules/identity/src/application/resolve-actor.ts",
        "reason": "json z security definer → ActorJson; cast na granicy SQL"
      },
      {
        "path": "packages/ui/src/charts/LineChart.tsx",
        "reason": "Recharts 3 + React 19: ReferenceLine JSX types mismatch"
      }
    ],
